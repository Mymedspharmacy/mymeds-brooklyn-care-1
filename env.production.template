# =============================================================================
# PRODUCTION ENVIRONMENT TEMPLATE - MyMeds Pharmacy Inc.
# =============================================================================
# Copy this file to .env.production and fill in your actual values
# DO NOT commit the actual .env.production file to version control
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# MySQL Database (Production)
DATABASE_URL="mysql://mymeds_user:YOUR_SECURE_DB_PASSWORD@mysql:3306/mymeds_production"

# MySQL Connection Details
MYSQL_ROOT_PASSWORD=YOUR_SECURE_ROOT_PASSWORD
MYSQL_DATABASE=mymeds_production
MYSQL_USER=mymeds_user
MYSQL_PASSWORD=YOUR_SECURE_DB_PASSWORD

# Database Connection Pool
DB_MAX_CONNECTIONS=20
DB_CONNECTION_TIMEOUT=30000

# MySQL Configuration
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci

# =============================================================================
# JWT & AUTHENTICATION
# =============================================================================
# Generate secure JWT secret (use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=YOUR_SUPER_SECURE_JWT_SECRET_KEY_HERE_64_CHARACTERS_MINIMUM
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt Rounds (higher = more secure but slower)
BCRYPT_ROUNDS=12

# =============================================================================
# ADMIN CREDENTIALS
# =============================================================================
ADMIN_EMAIL=admin@mymedspharmacyinc.com
ADMIN_PASSWORD=YOUR_SECURE_ADMIN_PASSWORD_HERE
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# SMTP Settings (Gmail example - use your preferred email service)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=mymedspharmacyinc@gmail.com
EMAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD_HERE
EMAIL_FROM=mymedspharmacyinc@gmail.com
EMAIL_FROM_NAME="MyMeds Pharmacy Inc."

# Alternative: SendGrid Configuration
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASSWORD=YOUR_SENDGRID_API_KEY
# EMAIL_FROM=noreply@mymedspharmacyinc.com

# =============================================================================
# WORDPRESS INTEGRATION
# =============================================================================
# WordPress Site Configuration
VITE_WORDPRESS_URL=https://mymedspharmacyinc.com/blog
WORDPRESS_URL=https://mymedspharmacyinc.com/blog
WORDPRESS_USERNAME=mymeds_api_user
WORDPRESS_PASSWORD=YOUR_WORDPRESS_APP_PASSWORD
WORDPRESS_APP_PASSWORD=YOUR_WORDPRESS_APP_PASSWORD

# WordPress Database (if separate from main DB)
WORDPRESS_DB_HOST=mysql:3306
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=mymeds_user
WORDPRESS_DB_PASSWORD=YOUR_SECURE_DB_PASSWORD

# WordPress Features
FEATURE_WORDPRESS_ENABLED=true

# =============================================================================
# WOOCOMMERCE INTEGRATION
# =============================================================================
# WooCommerce Store Configuration
WOOCOMMERCE_STORE_URL=https://mymedspharmacyinc.com/shop
WOOCOMMERCE_CONSUMER_KEY=ck_YOUR_WOOCOMMERCE_CONSUMER_KEY_HERE
WOOCOMMERCE_CONSUMER_SECRET=cs_YOUR_WOOCOMMERCE_CONSUMER_SECRET_HERE
WOOCOMMERCE_WEBHOOK_SECRET=YOUR_WOOCOMMERCE_WEBHOOK_SECRET_HERE

# WooCommerce Features
FEATURE_WOOCOMMERCE_ENABLED=true

# =============================================================================
# PAYMENT GATEWAY CONFIGURATION
# =============================================================================
# Stripe Configuration (if using Stripe)
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET_HERE

# PayPal Configuration (if using PayPal)
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET
PAYPAL_MODE=live

# Payment Gateway Features
PAYMENT_GATEWAY_ENABLED=true

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ORIGIN=https://www.mymedspharmacyinc.com,https://mymedspharmacyinc.com
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,Accept,Origin,Cache-Control

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Session Security
SESSION_SECRET=YOUR_SESSION_SECRET_KEY_HERE_64_CHARACTERS_MINIMUM

# Security Features
HELMET_ENABLED=true
XSS_PROTECTION=true
CONTENT_SECURITY_POLICY=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH=20
RATE_LIMIT_CONTACT=50
RATE_LIMIT_GENERAL=1000

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
# Compression
COMPRESSION_ENABLED=true

# Clustering
CLUSTER_ENABLED=true
CLUSTER_WORKERS=2

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL=300000
CACHE_MAX_SIZE=1000

# =============================================================================
# MONITORING & HEALTH CHECKS
# =============================================================================
# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000

# Monitoring
MONITORING_ENABLED=true
MONITORING_MEMORY_THRESHOLD=1024

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
# Upload Limits
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/plain

# File Storage
UPLOAD_PATH=./uploads
MAX_FILES_PER_REQUEST=5

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Backup Settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups

# AWS S3 Backup (if using S3)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=mymeds-pharmacy-backups

# =============================================================================
# EXTERNAL API INTEGRATIONS
# =============================================================================
# OpenFDA API (for medication data)
OPENFDA_API_KEY=YOUR_OPENFDA_API_KEY_HERE

# Pharmacy APIs
GOODRX_API_KEY=YOUR_GOODRX_API_KEY_HERE
GOODRX_API_SECRET=YOUR_GOODRX_API_SECRET_HERE

# =============================================================================
# VPS & HOSTING CONFIGURATION
# =============================================================================
# VPS Provider API (Hostinger example)
HOSTINGER_API_TOKEN=YOUR_HOSTINGER_API_TOKEN_HERE
HOSTINGER_API_URL=https://developers.hostinger.com/api/vps/v1
VPS_DOMAIN=mymedspharmacyinc.com
VPS_IP=YOUR_VPS_IP_ADDRESS

# =============================================================================
# SSL/TLS CONFIGURATION
# =============================================================================
# SSL Certificate Paths (Let's Encrypt)
SSL_CERT_PATH=/etc/letsencrypt/live/mymedspharmacyinc.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/mymedspharmacyinc.com/privkey.pem

# =============================================================================
# DEBUG & DEVELOPMENT (DISABLE IN PRODUCTION)
# =============================================================================
DEBUG_MODE=false
VERBOSE_LOGGING=false
ENABLE_DEV_TOOLS=false

# =============================================================================
# THIRD-PARTY INTEGRATIONS
# =============================================================================
# Google Analytics
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID

# Facebook Pixel
FACEBOOK_PIXEL_ID=YOUR_FACEBOOK_PIXEL_ID

# Twilio (for SMS notifications)
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+1234567890

# =============================================================================
# COMPLIANCE & LEGAL
# =============================================================================
# HIPAA Compliance
HIPAA_COMPLIANCE_ENABLED=true
DATA_ENCRYPTION_ENABLED=true

# GDPR Compliance
GDPR_COMPLIANCE_ENABLED=true
DATA_RETENTION_DAYS=2555

# =============================================================================
# CUSTOM BUSINESS CONFIGURATION
# =============================================================================
# Business Information
BUSINESS_NAME="MyMeds Pharmacy Inc."
BUSINESS_PHONE="+1-555-123-4567"
BUSINESS_ADDRESS="123 Pharmacy Street, Brooklyn, NY 11201"
BUSINESS_HOURS="Mon-Fri: 9AM-7PM, Sat: 9AM-5PM, Sun: 10AM-4PM"

# Pharmacy License
PHARMACY_LICENSE_NUMBER=YOUR_PHARMACY_LICENSE_NUMBER
PHARMACIST_LICENSE_NUMBER=YOUR_PHARMACIST_LICENSE_NUMBER

# =============================================================================
# NOTIFICATION SETTINGS
# =============================================================================
# Email Notifications
EMAIL_NOTIFICATIONS_ENABLED=true
SMS_NOTIFICATIONS_ENABLED=true

# Notification Templates
WELCOME_EMAIL_TEMPLATE=welcome
REFILL_REMINDER_TEMPLATE=refill_reminder
APPOINTMENT_REMINDER_TEMPLATE=appointment_reminder
