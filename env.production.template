# =============================================================================
# MyMeds Pharmacy Inc. - Production Environment Configuration
# =============================================================================
# Copy this file to .env.production when deploying
# =============================================================================

# =============================================================================
# BASIC SERVER CONFIGURATION
# =============================================================================
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# For MySQL Production
DATABASE_URL="mysql://mymeds_user:REPLACE_WITH_SECURE_PASSWORD@localhost:3306/mymeds_production"

# Additional MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=mymeds_production
MYSQL_USER=mymeds_user
MYSQL_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_SECURE_ROOT_PASSWORD

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT Configuration - REPLACE WITH SECURE KEYS
JWT_SECRET=REPLACE_WITH_SECURE_JWT_SECRET_KEY_HERE_MINIMUM_64_CHARACTERS_LONG
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Session Security
SESSION_SECRET=REPLACE_WITH_SECURE_SESSION_SECRET_KEY_HERE_MINIMUM_32_CHARACTERS_LONG

# Password Hashing
BCRYPT_ROUNDS=12

# CSRF Protection
CSRF_SECRET=REPLACE_WITH_SECURE_CSRF_SECRET_KEY_HERE_MINIMUM_64_CHARACTERS_LONG

# =============================================================================
# ADMIN ACCOUNT CONFIGURATION
# =============================================================================
ADMIN_EMAIL=admin@mymedspharmacyinc.com
ADMIN_PASSWORD_HASH=REPLACE_WITH_HASHED_ADMIN_PASSWORD_HERE
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=admin@mymedspharmacyinc.com
EMAIL_PASSWORD=REPLACE_WITH_GMAIL_APP_PASSWORD_HERE
EMAIL_FROM=admin@mymedspharmacyinc.com
EMAIL_FROM_NAME="MyMeds Pharmacy Inc."

# =============================================================================
# WORDPRESS INTEGRATION
# =============================================================================
WORDPRESS_URL=https://blog.mymedspharmacyinc.com
WORDPRESS_USERNAME=REPLACE_WITH_WORDPRESS_USERNAME
WORDPRESS_APP_PASSWORD=REPLACE_WITH_WORDPRESS_APPLICATION_PASSWORD
FEATURE_WORDPRESS_ENABLED=true

# =============================================================================
# WOOCOMMERCE INTEGRATION
# =============================================================================
WOOCOMMERCE_STORE_URL=https://shop.mymedspharmacyinc.com
WOOCOMMERCE_CONSUMER_KEY=ck_REPLACE_WITH_CONSUMER_KEY_HERE
WOOCOMMERCE_CONSUMER_SECRET=cs_REPLACE_WITH_CONSUMER_SECRET_HERE
WOOCOMMERCE_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET_HERE
FEATURE_WOOCOMMERCE_ENABLED=true

# =============================================================================
# FRONTEND ENVIRONMENT VARIABLES (VITE_*)
# =============================================================================
# Backend URL for frontend to connect
VITE_BACKEND_URL=https://mymedspharmacyinc.com
VITE_API_BASE_URL=/api

# External Services
VITE_WORDPRESS_URL=https://blog.mymedspharmacyinc.com
VITE_WOOCOMMERCE_URL=https://shop.mymedspharmacyinc.com
VITE_WOOCOMMERCE_STORE_URL=https://shop.mymedspharmacyinc.com
VITE_WOOCOMMERCE_CONSUMER_KEY=ck_REPLACE_WITH_CONSUMER_KEY_HERE
VITE_WOOCOMMERCE_CONSUMER_SECRET=cs_REPLACE_WITH_CONSUMER_SECRET_HERE

# Feature Flags
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_ANALYTICS=false

# Contact Information
VITE_PHONE_NUMBER=+123456789
VITE_CONTACT_EMAIL=contact@mymedspharmacyinc.com
VITE_PHARMACY_ADDRESS=Your Pharmacy Address Here
VITE_PHARMACY_HOURS=Mon-Fri: 9AM-7PM, Sat: 9AM-5PM, Sun: 10AM-4PM
VITE_GOOGLE_MAPS_URL=https://www.google.com/maps/YOUR_LOCATION_URL

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ORIGIN=https://mymedspharmacyinc.com,https://www.mymedspharmacyinc.com,https://blog.mymedspharmacyinc.com,https://shop.mymedspharmacyinc.com
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,Accept,Origin,Cache-Control

# =============================================================================
# PRODUCTION-SPECIFIC CONFIGURATION
# =============================================================================
# Production settings (enabled)
RATE_LIMIT_ENABLED=true
HELMET_ENABLED=true
COMPRESSION_ENABLED=true
DEBUG_MODE=false
VERBOSE_LOGGING=false
ENABLE_DEV_TOOLS=false
LOG_LEVEL=info

# Logging
LOG_FILE_PATH=./logs/production.log

# Security Headers (enabled for production)
XSS_PROTECTION=true
CONTENT_SECURITY_POLICY=true

# =============================================================================
# EXTERNAL API KEYS (Optional Integrations)
# =============================================================================
# Google Maps API (for geocoding)
GOOGLE_MAPS_API_KEY=REPLACE_WITH_GOOGLE_MAPS_API_KEY_HERE

# Sentry (for error tracking)
SENTRY_DSN=REPLACE_WITH_SENTRY_DSN_HERE

# Analytics
GOOGLE_ANALYTICS_ID=REPLACE_WITH_GA_TRACKING_ID_HERE
FACEBOOK_PIXEL_ID=REPLACE_WITH_FACEBOOK_PIXEL_ID_HERE

