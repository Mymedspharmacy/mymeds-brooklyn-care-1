# =============================================================================
# DEVELOPMENT ENVIRONMENT - MyMeds Pharmacy Inc.
# =============================================================================

# Server Configuration
NODE_ENV=development
PORT=4000
HOST=localhost

# Database Configuration (SQLite for development)
DATABASE_URL="file:./prisma/dev.db"

# JWT & Authentication
JWT_SECRET=MyMeds2025!JWTSecretKey_Development_Secure_2025!@#$%^&*()
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Admin Credentials (Development)
ADMIN_EMAIL=admin@mymedspharmacyinc.com
ADMIN_PASSWORD_HASH=$2b$12$LQv3c1yqBWVHxkd0LHAkCOYz6TtxMQJqhN8/LewdBPj4J8K8K8K8K8
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# Email Configuration (Development - using console)
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USER=dev@mymedspharmacyinc.com
EMAIL_PASSWORD=dev_password
EMAIL_FROM=dev@mymedspharmacyinc.com
EMAIL_FROM_NAME="MyMeds Pharmacy Inc. (Dev)"

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:3001
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,Accept,Origin,Cache-Control

# WordPress Integration (Development)
WORDPRESS_URL=http://localhost:8080/blog
WORDPRESS_USERNAME=dev_user
WORDPRESS_APP_PASSWORD=dev_password
FEATURE_WORDPRESS_ENABLED=false

# WooCommerce Integration (Development)
WOOCOMMERCE_STORE_URL=http://localhost:8080/shop
WOOCOMMERCE_CONSUMER_KEY=dev_key
WOOCOMMERCE_CONSUMER_SECRET=dev_secret
WOOCOMMERCE_WEBHOOK_SECRET=dev_webhook_secret
FEATURE_WOOCOMMERCE_ENABLED=false

# Security Configuration
SESSION_SECRET=MyMeds2025!SessionSecret_Development_Secure_2025!@#$%^&*()
HELMET_ENABLED=true
XSS_PROTECTION=true
CONTENT_SECURITY_POLICY=true

# Rate Limiting (More permissive for development)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Logging
LOG_LEVEL=debug
LOG_FILE_PATH=./logs/app.log

# Performance
COMPRESSION_ENABLED=true
CLUSTER_ENABLED=false
CLUSTER_WORKERS=1

# Debug (ENABLED FOR DEVELOPMENT)
DEBUG_MODE=true
VERBOSE_LOGGING=true
DISABLE_RATE_LIMIT=true

# CSRF Secret
CSRF_SECRET=MyMeds2025!CSRFSecret_Development_Secure_2025!@#$%^&*()
