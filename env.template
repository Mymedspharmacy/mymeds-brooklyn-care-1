# MyMeds Pharmacy Environment Configuration
# Copy to .env and replace YOUR_* values

NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Database
DATABASE_URL="mysql://mymeds_user:YOUR_DB_PASSWORD@localhost:3306/mymeds_production"
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=mymeds_production
MYSQL_USER=mymeds_user
MYSQL_PASSWORD=YOUR_DB_PASSWORD

# Security
JWT_SECRET=YOUR_JWT_SECRET_HERE_64_CHARACTERS_MINIMUM
SESSION_SECRET=YOUR_SESSION_SECRET_HERE_32_CHARACTERS_MINIMUM
CSRF_SECRET=YOUR_CSRF_SECRET_HERE_64_CHARACTERS_MINIMUM

# Admin
ADMIN_EMAIL=admin@mymedspharmacyinc.com
ADMIN_PASSWORD_HASH=YOUR_HASHED_ADMIN_PASSWORD_HERE

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=YOUR_EMAIL_ADDRESS@gmail.com
EMAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD
EMAIL_FROM=YOUR_EMAIL_ADDRESS@gmail.com

# WordPress
WORDPRESS_URL=https://blog.mymedspharmaceuticals.com
WORDPRESS_USERNAME=YOUR_WP_USERNAME
WORDPRESS_APP_PASSWORD=YOUR_WP_APP_PASSWORD
FEATURE_WORDPRESS_ENABLED=true

# WooCommerce
WOOCOMMERCE_STORE_URL=https://shop.mymedspharmaceuticals.com
WOOCOMMERCE_CONSUMER_KEY=ck_YOUR_CONSUMER_KEY
WOOCOMMERCE_CONSUMER_SECRET=cs_YOUR_CONSUMER_SECRET
FEATURE_WOOCOMMERCE_ENABLED=true

# Frontend
VITE_BACKEND_URL=https://mymedspharmaceuticals.com
VITE_WORDPRESS_URL=https://blog.mymedspharmaceuticals.com
VITE_WOOCOMMERCE_URL=https://shop.mymedspharmaceuticals.com
VITE_CONTACT_EMAIL=contact@mymedspharmaceuticals.com

# CORS
CORS_ORIGIN=https://mymedspharmaceuticals.com,https://www.mymedspharmaceuticals.com,https://blog.mymedspharmaceuticals.com,https://shop.mymedspharmaceuticals.com

# Production
RATE_LIMIT_ENABLED=true
HELMET_ENABLED=true
COMPRESSION_ENABLED=true
DEBUG_MODE=false