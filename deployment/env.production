# MyMeds Pharmacy - Production Environment Configuration
# Copy this file to your VPS and rename to .env

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# =============================================================================
# DATABASE CONFIGURATION (MySQL)
# =============================================================================
DATABASE_URL="mysql://mymeds_user:your_secure_password_here@localhost:3306/mymeds_pharmacy"

# =============================================================================
# JWT & SECURITY
# =============================================================================
# Generate a strong JWT secret (32+ characters)
JWT_SECRET=your_super_secure_jwt_secret_key_here_minimum_32_characters

# Generate a strong CSRF secret (32+ characters)
CSRF_SECRET=your_super_secure_csrf_secret_key_here_minimum_32_characters

# =============================================================================
# ADMIN CREDENTIALS
# =============================================================================
# Admin email (change this to your admin email)
ADMIN_EMAIL=admin@mymedspharmacy.com

# Admin password hash (generate with: node -e "console.log(require('bcrypt').hashSync('your_password', 12))")
ADMIN_PASSWORD_HASH=$2b$12$xOdf7If2PvG4w397RBLwNe7GZSQFnyFNsQWLA9402XQ0TmuBsvuz6

# Admin name
ADMIN_NAME=Admin User

# =============================================================================
# WOOCOMMERCE INTEGRATION
# =============================================================================
WOOCOMMERCE_STORE_URL=https://mymedspharmacyinc.com
WOOCOMMERCE_CONSUMER_KEY=ck_your_consumer_key_here
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret_here
WOOCOMMERCE_WEBHOOK_SECRET=your_webhook_secret_here

# =============================================================================
# WORDPRESS INTEGRATION
# =============================================================================
WORDPRESS_SITE_URL=https://mymedspharmacyinc.com
WORDPRESS_USERNAME=your_wordpress_username
WORDPRESS_APPLICATION_PASSWORD=your_wordpress_app_password

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# SMTP settings for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Email addresses
FROM_EMAIL=noreply@mymedspharmacyinc.com
ADMIN_EMAIL_NOTIFICATIONS=admin@mymedspharmacyinc.com

# =============================================================================
# FILE UPLOAD & STORAGE
# =============================================================================
# Maximum file upload size (in bytes)
MAX_FILE_SIZE=10485760

# Upload directory
UPLOAD_DIR=/var/www/mymeds/uploads

# =============================================================================
# RATE LIMITING
# =============================================================================
# Rate limiting settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# LOGGING
# =============================================================================
# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Log directory
LOG_DIR=/var/www/mymeds/logs

# =============================================================================
# CORS & SECURITY
# =============================================================================
# Allowed origins (comma-separated)
CORS_ORIGIN=https://mymedspharmacyinc.com,https://www.mymedspharmacyinc.com

# Trust proxy (for reverse proxy setups)
TRUST_PROXY=true

# =============================================================================
# SSL/TLS
# =============================================================================
# SSL certificate paths (if using HTTPS directly)
SSL_CERT_PATH=/etc/ssl/certs/mymedspharmacyinc.com.crt
SSL_KEY_PATH=/etc/ssl/private/mymedspharmacyinc.com.key

# =============================================================================
# MONITORING & HEALTH CHECKS
# =============================================================================
# Health check endpoint
HEALTH_CHECK_ENABLED=true

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Backup directory
BACKUP_DIR=/var/www/mymeds/backups

# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# =============================================================================
# DEVELOPMENT OVERRIDES (set to false in production)
# =============================================================================
# Disable rate limiting in development
DISABLE_RATE_LIMIT=false

# Enable debug mode
DEBUG=false

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# OpenFDA API (for drug information)
OPENFDA_API_URL=https://api.fda.gov

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Frontend URL
FRONTEND_URL=https://mymedspharmacyinc.com

# API URL
API_URL=https://mymedspharmacyinc.com/api
