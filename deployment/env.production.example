# MyMeds Pharmacy Production Environment Configuration
# Copy this to /var/www/mymeds-pharmacy/backend/.env on the VPS

# Database Configuration
DATABASE_URL="mysql://mymeds_user:secure_password@localhost:3306/mymeds_production"

# JWT Configuration
JWT_SECRET="mymeds-pharmacy-jwt-secret-key-minimum-32-characters-long-for-security-production"
JWT_EXPIRES_IN="24h"

# Application Configuration
NODE_ENV="production"
PORT=4000
CORS_ORIGIN="https://mymedspharmacyinc.com"

# Admin Credentials
ADMIN_EMAIL="mymedspharmacy@outlook.com"
ADMIN_PASSWORD="AdminPassword123!"
ADMIN_NAME="Admin User"

# Security Configuration
CSRF_SECRET="mymeds-pharmacy-csrf-secret-key-minimum-32-characters-long-for-security-production"
BCRYPT_ROUNDS=12

# WooCommerce Integration
WOOCOMMERCE_STORE_URL="https://mymedspharmacyinc.com/shop"
WOOCOMMERCE_CONSUMER_KEY="ck_your_consumer_key_here"
WOOCOMMERCE_CONSUMER_SECRET="cs_your_consumer_secret_here"

# WordPress Integration
VITE_WORDPRESS_URL="https://mymedspharmacyinc.com/shop"
VITE_WORDPRESS_API_URL="https://mymedspharmacyinc.com/shop/wp-json/wp/v2"

# Email Configuration (SMTP)
EMAIL_HOST="smtp.office365.com"
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER="noreply@mymedspharmacyinc.com"
EMAIL_PASS="your_email_password_here"
EMAIL_FROM="noreply@mymedspharmacyinc.com"

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR="/var/www/mymeds-pharmacy/uploads"

# Monitoring and Logging
LOG_LEVEL="info"
LOG_FILE="/var/www/mymeds-pharmacy/logs/app.log"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET="mymeds-pharmacy-session-secret-key-minimum-32-characters-long"
SESSION_MAX_AGE=86400000

# Backup Configuration
BACKUP_DIR="/var/backups/mymeds-pharmacy"
BACKUP_RETENTION_DAYS=30

# Security Headers
SECURITY_HEADERS_ENABLED=true
CSP_REPORT_URI="https://mymedspharmacyinc.com/api/security/csp-report"

# Performance Configuration
CACHE_ENABLED=true
CACHE_TTL=3600
REDIS_URL="redis://localhost:6379"

# Analytics (Optional)
GOOGLE_ANALYTICS_ID="GA-XXXXXXXXX"
GOOGLE_TAG_MANAGER_ID="GTM-XXXXXXX"

# Third-party Integrations
STRIPE_PUBLIC_KEY="pk_live_your_stripe_public_key"
STRIPE_SECRET_KEY="sk_live_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Social Media Integration
FACEBOOK_APP_ID="your_facebook_app_id"
TWITTER_HANDLE="@mymedspharmacy"

# Notification Services
PUSH_NOTIFICATION_KEY="your_push_notification_key"
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/your/webhook/url"

# Development/Testing Flags
DEBUG_MODE=false
MAINTENANCE_MODE=false
ENABLE_DEBUG_ROUTES=false
